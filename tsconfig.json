/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@shared/*": ["./src/app/shared/*"],
      "@layouts/*": ["./src/app/features/layouts/*"],
      "@auth/*": ["./src/app/features/auth/*"],
      "@home/*": ["./src/app/features/home/*"],
      "@bank-transactions/*": ["./src/app/features/bank-transactions/*"],
      "@assistant/*": ["./src/app/features/assistant/*"],
      "@savings-goals/*": ["./src/app/features/savings-goals/*"],
      "@transfers/*": ["./src/app/features/transfers/*"],
      "@services/*": ["./src/app/core/services/*"],
      "@helpers/*": ["./src/app/core/helpers/*"],
      "@environments/*": ["./src/environments/*"],
      "@stores/*": ["./src/app/core/stores/*"],
      "@guards/*": ["./src/app/core/guards/*"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}